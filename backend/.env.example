APP_NAME=Warda
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://warda:warda@localhost:5432/warda
# Local fallback without Docker:
# DATABASE_URL=sqlite:///./warda.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=*
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=5
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=3145728
FREE_DELIVERY_THRESHOLD=100000
DELIVERY_FEE=5000
OTP_DEV_RETURN_CODE=true
